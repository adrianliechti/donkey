# Packaging for donkey-server. The Go binary is cross-compiled by
# `task server-image`; this image wraps it.
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
# No USER: the image states no opinion about who it runs as, because the
# answer differs per runtime and only the runtime can enforce it anyway.
# Kubernetes pins an unprivileged uid in the pod's security context (see
# manifests.systemPodSecurityContext) alongside the capability and seccomp
# rules that make it mean something; on Docker the server holds the engine
# socket, which is already the whole of its power, so dropping privileges
# inside its own container would buy nothing.
#
# Everything the server writes goes to /tmp — world-writable, so it works
# under whichever uid a runtime picks. That is the build contexts it unpacks,
# and nothing else: the build itself happens in buildkitd, and the only thing
# donkey-server needs to reach is the model endpoint. HOME points at /tmp for
# the same reason; a numeric uid would otherwise be handed /root, which it
# cannot write.
ENV HOME=/tmp
# TARGETARCH comes from BuildKit: the daemon's own arch for a plain build,
# each platform in turn for a multi-arch `task publish`.
ARG TARGETARCH
COPY --chmod=0755 donkey-server-${TARGETARCH} /donkey-server
ENTRYPOINT ["/donkey-server"]
